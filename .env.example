# Local development placeholders. Copy this file to .env.
POSTGRES_DB=live_copilot
POSTGRES_USER=live_copilot
POSTGRES_PASSWORD=local-postgres-placeholder
RABBITMQ_DEFAULT_USER=live_copilot
RABBITMQ_DEFAULT_PASS=local-rabbitmq-placeholder
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=live-copilot.v1
OUTBOX_ENABLED=true
LOG_LEVEL=INFO
ASR_BACKEND=faster-whisper
ASR_MODEL_PATH=models/faster-whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=ru
LLM_ENABLED=true
LLM_ENDPOINT=http://127.0.0.1:8080/v1
LLM_MODEL=Forge-1-E2B-Q4_K_M.gguf
